# Documentation only: the server reads process environment, not this file.
# ADC is discovered by GoogleAuth. No access token setting is used.
# Optional local credential file (outside repository/frontend):
# GOOGLE_APPLICATION_CREDENTIALS=C:/PRIVATE_DIRECTORY/adc.json
# Browser-safe game configuration only (never credentials):
# GAME_CONFIGURATION_FILE=C:/PRIVATE_DIRECTORY/game-configuration.json
# PORT=3000
# Explicit modes: live (default), preview (offline illustrative game).
GAME_MODE=live
