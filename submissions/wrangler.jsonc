{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gotta-detect-em-all",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-25",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
